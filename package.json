{
  "name": "communicationapp",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "package": "electron-packager . \"Communication Styles\" --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --ignore=\"^/(?!(electron-main\\.js|preload\\.js|external-links\\.js|index\\.html|icon\\.ico|icons|package\\.json)(/|$))\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.communicationapp",
    "productName": "Communication Styles",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "external-links.js",
      "index.html",
      "icon.ico",
      "icons/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}
